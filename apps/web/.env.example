# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="your_openai_model"
OPENAI_CONTENT_ANALYSIS_MODEL="your_content_analysis_model"
OPENAI_SCORE_MODEL="your_score_model"
OPENAI_IMAGE_MODEL="your_image_model"
OPENAI_IMAGE_QUALITY="high"
OPENAI_IMAGE_OUTPUT_FORMAT="png"

# Meta Integration Platform
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_GRAPH_API_VERSION="v25.0"
META_OAUTH_REDIRECT_URI="http://localhost:3000/api/meta/oauth/callback"
META_OAUTH_SCOPES="public_profile,pages_show_list,pages_read_engagement,ads_read,ads_management,business_management"
META_OAUTH_STATE_SECRET="replace_with_at_least_32_random_characters"
META_TOKEN_ENCRYPTION_KEY="replace_with_a_base64_encoded_32_byte_key"

# Meta read/sync controls
META_SELECTED_PAGE_IDS=""
META_SYNC_MAX_POST_PAGES="10"

# Meta Marketing API safety controls
META_MARKETING_API_MODE="READ_ONLY"
META_MARKETING_API_WRITES_ENABLED="false"
META_ALLOWED_AD_ACCOUNT_IDS=""
META_API_TIMEOUT_MS="15000"
META_API_MAX_RETRIES="2"
CONTENT_BACKFILL_OWNER_KEY="replace_with_a_long_random_owner_key"
CRON_SECRET="replace_with_a_long_random_cron_secret"

# Legacy temporary tokens
# Supported only while the Phase 1 OAuth migration is incomplete.
META_USER_ACCESS_TOKEN=""
META_ACCESS_TOKEN=""
